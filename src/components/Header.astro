---
// Header.astro
---
<header class="bg-gradient-to-l from-ivory-100 via-white to-ivory-100 border-b border-amber-200/70 sticky top-0 z-30 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 py-3 sm:py-4">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      
      <!-- عنوان و تاریخ مراسم -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-amber-700 text-white flex items-center justify-center shadow-md shrink-0">
            <!-- آیکون حلقه ازدواج SVG -->
            <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l2.5 3.5L12 10 9.5 6.5 12 3z" />
              <circle cx="9.5" cy="14.5" r="5" />
              <circle cx="14.5" cy="14.5" r="5" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-lg sm:text-xl font-extrabold text-gray-900 tracking-tight">پلنر هوشمند عروسی</h1>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
                ۴ آذر ۱۴۰۵
              </span>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5" id="wedding-gregorian-label">
              چهارشنبه ۴ آذر ۱۴۰۵ (۲۵ نوامبر ۲۰۲۶) • شروع تالار ۱۸:۰۰ | ورود ۲۰:۰۰
            </p>
          </div>
        </div>

        <!-- دکمه تنظیم تاریخ شبیه‌سازی (برای موبایل) -->
        <button onclick="window.planner.openSettingsModal()" title="تنظیم تاریخ یا بازنشانی" class="no-print lg:hidden p-2.5 rounded-xl bg-white border border-gray-200 text-gray-600 hover:bg-gray-50 active:scale-95 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>

      <!-- باکس شمارش معکوس و پیشرفت -->
      <div class="flex flex-wrap items-center justify-between sm:justify-end gap-3">
        <!-- شمارش معکوس زنده -->
        <div class="flex items-center gap-2 bg-white border border-amber-200/80 rounded-2xl px-3 py-2 shadow-sm">
          <div class="text-center px-2 border-l border-gray-100">
            <span id="cd-days" class="block text-lg sm:text-xl font-black text-amber-700 leading-none">0</span>
            <span class="text-[11px] text-gray-500 font-medium">روز</span>
          </div>
          <div class="text-center px-2 border-l border-gray-100">
            <span id="cd-hours" class="block text-lg sm:text-xl font-black text-gray-800 leading-none">0</span>
            <span class="text-[11px] text-gray-500 font-medium">ساعت</span>
          </div>
          <div class="text-center px-2">
            <span id="cd-minutes" class="block text-lg sm:text-xl font-black text-gray-800 leading-none">0</span>
            <span class="text-[11px] text-gray-500 font-medium">دقیقه</span>
          </div>
          <div class="pr-2 border-r border-amber-100">
            <span id="countdown-badge" class="inline-block text-xs font-bold px-2.5 py-1 rounded-xl bg-sage-100 text-sage-700">
              در حال محاسبه...
            </span>
          </div>
        </div>

        <!-- دکمه‌های عملیاتی دسکتاپ -->
        <div class="no-print hidden lg:flex items-center gap-2">
          <button onclick="window.planner.openAddModal()" class="flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-sage-600 hover:bg-sage-700 text-white text-sm font-semibold shadow-sm transition active:scale-95">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            <span>افزودن کار جدید</span>
          </button>
          <button onclick="window.print()" class="flex items-center gap-1.5 px-3 py-2.5 rounded-xl bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 text-sm font-medium transition" title="چاپ یا ذخیره PDF برنامه">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            <span>چاپ برنامه</span>
          </button>
          <button onclick="window.planner.openSettingsModal()" class="p-2.5 rounded-xl bg-white hover:bg-gray-50 text-gray-600 border border-gray-200 transition" title="تنظیمات و بازنشانی">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- نوار پیشرفت کلی آماده‌سازی -->
    <div class="mt-3 pt-2.5 border-t border-amber-100/80 flex items-center gap-3">
      <span class="text-xs font-semibold text-gray-600 shrink-0">پیشرفت آماده‌سازی:</span>
      <div class="flex-1 h-2.5 bg-amber-100/80 rounded-full overflow-hidden">
        <div id="overall-progress-bar" class="h-full bg-gradient-to-l from-sage-600 to-amber-500 rounded-full transition-all duration-500" style="width: 0%"></div>
      </div>
      <span id="overall-progress-text" class="text-xs font-bold text-gray-800 shrink-0">۰٪ (۰ از ۰)</span>
    </div>
  </div>
</header>
