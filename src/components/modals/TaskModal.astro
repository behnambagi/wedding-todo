---
// TaskModal.astro
---
<div id="task-modal" class="no-print fixed inset-0 z-50 hidden items-end sm:items-center justify-center bg-black/60 backdrop-blur-xs p-0 sm:p-4">
  <div class="bg-white rounded-t-3xl sm:rounded-3xl max-w-lg w-full p-4 sm:p-6 shadow-2xl border border-gray-100 fade-in max-h-[85vh] sm:max-h-[90vh] overflow-y-auto">
    <!-- نشانگر سوایپ موبایل -->
    <div class="w-10 h-1 bg-gray-200 rounded-full mx-auto mb-3 sm:hidden"></div>

    <div class="flex items-center justify-between pb-3 border-b border-gray-100">
      <h3 id="modal-title" class="text-base sm:text-lg font-extrabold text-gray-900">افزودن برنامه جدید</h3>
      <button type="button" onclick="window.planner.closeTaskModal()" class="p-1.5 sm:p-2 rounded-xl text-gray-400 hover:bg-gray-100 hover:text-gray-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="task-form" onsubmit="window.planner.saveTaskForm(event)" class="space-y-4 mt-4">
      <input type="hidden" id="edit-task-id" />

      <div>
        <label for="task-title" class="block text-xs font-bold text-gray-700 mb-1.5">عنوان کار یا رویداد *</label>
        <input type="text" id="task-title" required placeholder="مثلاً: تحویل دسته گل از گلفروشی یا یادآوری شاباش" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="task-phase" class="block text-xs font-bold text-gray-700 mb-1.5">فاز زمانی *</label>
          <select id="task-phase" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm bg-white focus:border-amber-500 outline-none">
            <option value="phase-week">فاز ۱: هفته آخر تا ۴ روز مانده</option>
            <option value="phase-3days">فاز ۲: ۳ تا ۲ روز مانده به عروسی</option>
            <option value="phase-1day">فاز ۳: ۱ روز مانده (۳ آذر - آماده‌سازی نهایی)</option>
            <option value="phase-wedding-day">فاز ۴: روز عروسی (۴ آذر - تایم‌لاین ساعتی)</option>
            <option value="phase-after">فاز ۵: روز بعد از مراسم (۵ آذر به بعد)</option>
          </select>
        </div>

        <div>
          <label for="task-time" class="block text-xs font-bold text-gray-700 mb-1.5">ساعت دقیق (اختیاری - برای روز عروسی عالیه)</label>
          <input type="text" id="task-time" placeholder="مثلاً 04:00 یا 20:00 یا صبح" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-amber-500 outline-none" dir="ltr" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label for="task-category" class="block text-xs font-bold text-gray-700 mb-1.5">دسته‌بندی</label>
          <select id="task-category" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm bg-white focus:border-amber-500 outline-none">
            <option value="تالار و پذیرایی">تالار و پذیرایی</option>
            <option value="آرایشگاه و لباس">آرایشگاه و لباس</option>
            <option value="آتلیه و رسانه">آتلیه و رسانه</option>
            <option value="گل‌آرایی و ماشین">گل‌آرایی و ماشین</option>
            <option value="مالی و مدارک">مالی و مدارک</option>
            <option value="کیف اضطراری">کیف اضطراری</option>
            <option value="اجرای مراسم">اجرای مراسم</option>
          </select>
        </div>

        <div>
          <label for="task-owner" class="block text-xs font-bold text-gray-700 mb-1.5">مسئول انجام</label>
          <select id="task-owner" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm bg-white focus:border-amber-500 outline-none">
            <option value="مشترک">مشترک (عروس و داماد)</option>
            <option value="عروس">عروس خانم</option>
            <option value="داماد">آقا داماد</option>
            <option value="خانواده/ساقدوش">خانواده / ساقدوش</option>
          </select>
        </div>

        <div>
          <label for="task-priority" class="block text-xs font-bold text-gray-700 mb-1.5">اولویت</label>
          <select id="task-priority" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm bg-white focus:border-amber-500 outline-none">
            <option value="high">فوری و حیاتی</option>
            <option value="medium" selected>معمولی</option>
            <option value="low">مکمل</option>
          </select>
        </div>
      </div>

      <div>
        <label for="task-notes" class="block text-xs font-bold text-gray-700 mb-1.5">جزئیات / یادداشت / شماره تماس هماهنگی</label>
        <textarea id="task-notes" rows="3" placeholder="توضیحات تکمیلی، آدرس یا نکات مهم این بخش..." class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:border-amber-500 outline-none"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
        <button type="button" onclick="window.planner.closeTaskModal()" class="px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold transition">انصراف</button>
        <button type="submit" class="px-5 py-2.5 rounded-xl bg-sage-600 hover:bg-sage-700 text-white text-sm font-bold shadow-sm transition">ذخیره در پلنر</button>
      </div>
    </form>
  </div>
</div>
