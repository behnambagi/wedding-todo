---
// SmartFocusBanner.astro
---
<section id="smart-focus-banner" class="bg-white rounded-2xl sm:rounded-3xl border sm:border-2 border-amber-300/80 shadow-xs sm:shadow-sm p-3.5 sm:p-5 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-28 h-28 bg-amber-100/30 rounded-full -translate-x-10 -translate-y-10 pointer-events-none"></div>
  <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-2.5 sm:gap-4">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-[10px] sm:text-xs font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span>
        <span>پیشنهاد هوشمند امروز</span>
      </div>
      <h2 id="smart-focus-title" class="text-sm sm:text-lg font-extrabold text-gray-900 leading-snug">
        در حال تحلیل برنامه شما...
      </h2>
      <p id="smart-focus-desc" class="text-[11px] sm:text-sm text-gray-600 leading-relaxed max-w-3xl">
        بر اساس تاریخ امروز و فاصله تا ۴ آذر، کارهای اولویت‌دار این بازه زمانی مشخص شده‌اند.
      </p>
    </div>
    <div class="no-print flex items-center gap-2 shrink-0 pt-1 sm:pt-0">
      <button onclick="window.planner.filterBySmartFocus()" class="flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white text-xs sm:text-sm font-bold shadow-xs transition active:scale-95">
        اولویت‌های امروز
      </button>
      <button onclick="window.planner.jumpToWeddingDay()" class="flex-1 sm:flex-none text-center px-3 sm:px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 active:bg-rose-200 text-rose-700 border border-rose-200 text-xs sm:text-sm font-bold transition active:scale-95">
        تایم‌لاین ۴ آذر
      </button>
    </div>
  </div>

  <!-- پیش‌نمایش سریع ۳ کار فوری امروز -->
  <div id="smart-quick-tasks" class="mt-2.5 sm:mt-3 pt-2.5 sm:pt-3 border-t border-gray-100 grid grid-cols-1 md:grid-cols-3 gap-2">
    <!-- به صورت داینامیک پر می‌شود -->
  </div>
</section>