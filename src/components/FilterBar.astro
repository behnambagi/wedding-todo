---
// FilterBar.astro
---
<section class="no-print bg-white rounded-2xl border border-gray-200/80 p-3 sm:p-4 shadow-sm space-y-3">
  <div class="flex flex-col md:flex-row gap-3">
    <!-- جستجو -->
    <div class="relative flex-1">
      <svg class="w-5 h-5 text-gray-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input type="text" id="search-input" oninput="window.planner.renderPlanner()" placeholder="جستجو در کارها، ساعت‌ها، تالار، آرایشگاه، مدارک..." class="w-full pr-10 pl-4 py-2.5 rounded-xl bg-gray-50 border border-gray-200 text-sm focus:bg-white focus:border-amber-500 focus:ring-2 focus:ring-amber-200 outline-none transition">
    </div>

    <!-- فیلتر وضعیت -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
      <button onclick="window.planner.setFilterStatus('all')" data-filter="all" class="filter-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition bg-gray-900 text-white">
        همه کارها
      </button>
      <button onclick="window.planner.setFilterStatus('focus')" data-filter="focus" class="filter-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition bg-gray-100 text-gray-700 hover:bg-gray-200">
        فقط اولویت امروز
      </button>
      <button onclick="window.planner.setFilterStatus('pending')" data-filter="pending" class="filter-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition bg-gray-100 text-gray-700 hover:bg-gray-200">
        انجام‌نشده‌ها
      </button>
      <button onclick="window.planner.setFilterStatus('completed')" data-filter="completed" class="filter-btn px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition bg-gray-100 text-gray-700 hover:bg-gray-200">
        تکمیل‌شده‌ها
      </button>
    </div>
  </div>

  <!-- فیلتر مسئول انجام کار و دسته‌بندی -->
  <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-gray-100 text-xs">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-gray-500 font-medium ml-1">مسئول:</span>
      <button onclick="window.planner.setOwnerFilter('all')" data-owner="all" class="owner-btn px-2.5 py-1 rounded-lg font-semibold bg-amber-100 text-amber-900">همه</button>
      <button onclick="window.planner.setOwnerFilter('مشترک')" data-owner="مشترک" class="owner-btn px-2.5 py-1 rounded-lg font-medium bg-gray-50 text-gray-600 hover:bg-gray-100">عروس و داماد</button>
      <button onclick="window.planner.setOwnerFilter('عروس')" data-owner="عروس" class="owner-btn px-2.5 py-1 rounded-lg font-medium bg-gray-50 text-gray-600 hover:bg-gray-100">عروس خانم</button>
      <button onclick="window.planner.setOwnerFilter('داماد')" data-owner="داماد" class="owner-btn px-2.5 py-1 rounded-lg font-medium bg-gray-50 text-gray-600 hover:bg-gray-100">آقا داماد</button>
      <button onclick="window.planner.setOwnerFilter('خانواده/ساقدوش')" data-owner="خانواده/ساقدوش" class="owner-btn px-2.5 py-1 rounded-lg font-medium bg-gray-50 text-gray-600 hover:bg-gray-100">ساقدوش / خانواده</button>
    </div>

    <div class="flex items-center gap-2">
      <button onclick="window.planner.openAddModal()" class="lg:hidden inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-sage-600 text-white font-semibold">
        <span>+ افزودن مورد</span>
      </button>
      <button onclick="window.print()" class="lg:hidden inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 font-semibold">
        <span>چاپ</span>
      </button>
    </div>
  </div>
</section>
