---
// MobileBottomNav.astro
---
<nav class="no-print lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/90 backdrop-blur-xl border-t border-amber-200/60 shadow-[0_-8px_25px_rgba(0,0,0,0.06)] px-3 pt-1.5 pb-safe">
  <div class="max-w-md mx-auto grid grid-cols-5 items-center justify-items-center relative">
    
    <!-- دکمه ۱: همه فازها -->
    <button id="nav-btn-all" onclick="window.planner.setActivePhaseTab('all')" class="group w-full flex flex-col items-center justify-center py-1 text-gray-400 hover:text-amber-700 active:scale-95 transition" aria-label="مشاهده کل برنامه">
      <div class="p-1 rounded-xl group-hover:bg-amber-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
        </svg>
      </div>
      <span class="text-[10px] font-bold mt-0.5 tracking-tight">همه</span>
    </button>

    <!-- دکمه ۲: وسایل همراه -->
    <button id="nav-btn-packing" onclick="window.planner.jumpToPackingList()" class="group w-full flex flex-col items-center justify-center py-1 text-gray-400 hover:text-amber-700 active:scale-95 transition" aria-label="وسایل همراه">
      <div class="p-1 rounded-xl group-hover:bg-amber-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
      </div>
      <span class="text-[10px] font-bold mt-0.5 tracking-tight">وسایل</span>
    </button>

    <!-- دکمه ۳: افزودن کار جدید (FAB شناور با گردینت اختصاصی و افکت شیشه‌ای) -->
    <div class="relative -top-3 flex items-center justify-center">
      <button onclick="window.planner.openAddModal()" class="w-13 h-13 rounded-full bg-gradient-to-tr from-amber-600 via-amber-500 to-rose-500 text-white shadow-lg shadow-amber-600/35 hover:shadow-amber-600/50 active:scale-90 transition-transform flex items-center justify-center border-4 border-white ring-2 ring-amber-100" aria-label="افزودن کار جدید">
        <svg class="w-6 h-6 stroke-[2.8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
      </button>
    </div>

    <!-- دکمه ۴: روز عروسی (۴ آذر) -->
    <button id="nav-btn-wedding" onclick="window.planner.jumpToWeddingDay()" class="group w-full flex flex-col items-center justify-center py-1 text-amber-700 active:scale-95 transition" aria-label="تایم‌لاین ۴ آذر">
      <div class="p-1 rounded-xl group-hover:bg-rose-50 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <span class="text-[10px] font-bold mt-0.5 tracking-tight">۴ آذر</span>
    </button>

    <!-- دکمه ۵: تنظیمات -->
    <button id="nav-btn-settings" onclick="window.planner.openSettingsModal()" class="group w-full flex flex-col items-center justify-center py-1 text-gray-400 hover:text-gray-700 active:scale-95 transition" aria-label="تنظیمات">
      <div class="p-1 rounded-xl group-hover:bg-gray-100 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <span class="text-[10px] font-bold mt-0.5 tracking-tight">تنظیمات</span>
    </button>

  </div>
</nav>
