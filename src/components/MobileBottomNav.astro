---
// MobileBottomNav.astro
---
<nav class="no-print lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-amber-200/70 shadow-[0_-4px_20px_rgba(0,0,0,0.07)] px-2 pt-1 pb-safe">
  <div class="max-w-md mx-auto grid grid-cols-5 items-end justify-items-center">
    
    <!-- دکمه خانه / همه -->
    <button id="nav-btn-all" onclick="window.planner.resetFilters(); window.scrollTo({top: 0, behavior: 'smooth'});" class="w-full flex flex-col items-center justify-center py-1.5 text-amber-700 active:scale-95 transition" aria-label="مشاهده کل برنامه">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span class="text-[10px] font-bold mt-0.5">همه</span>
    </button>

    <!-- دکمه وسایل همراه -->
    <button id="nav-btn-packing" onclick="window.planner.jumpToPackingList()" class="w-full flex flex-col items-center justify-center py-1.5 text-gray-500 hover:text-amber-700 active:scale-95 transition" aria-label="وسایل همراه">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
      </svg>
      <span class="text-[10px] font-bold mt-0.5">وسایل</span>
    </button>

    <!-- دکمه اصلی افزودن کار (Floating Action Button برجسته با سایز ارگونومیک) -->
    <button onclick="window.planner.openAddModal()" class="-mt-5 flex items-center justify-center w-13 h-13 rounded-full bg-gradient-to-tr from-sage-700 to-sage-500 text-white shadow-xl hover:shadow-sage-600/30 active:scale-90 transition-transform border-[3px] border-white" aria-label="افزودن کار جدید">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
    </button>

    <!-- دکمه روز عروسی (تایم‌لاین ۴ آذر) -->
    <button id="nav-btn-wedding" onclick="window.planner.jumpToWeddingDay()" class="w-full flex flex-col items-center justify-center py-1.5 text-gray-500 hover:text-rose-600 active:scale-95 transition" aria-label="تایم‌لاین ۴ آذر">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-[10px] font-bold mt-0.5">۴ آذر</span>
    </button>

    <!-- دکمه تنظیمات و تست تاریخ -->
    <button id="nav-btn-settings" onclick="window.planner.openSettingsModal()" class="w-full flex flex-col items-center justify-center py-1.5 text-gray-500 hover:text-gray-800 active:scale-95 transition" aria-label="تنظیمات">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="text-[10px] font-bold mt-0.5">تنظیمات</span>
    </button>

  </div>
</nav>
